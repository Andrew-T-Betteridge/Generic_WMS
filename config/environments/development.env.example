# DYNETIC WMS - DEVELOPMENT API ENVIRONMENT

DYNETIC_ENVIRONMENT=DEVELOPMENT

PORT=3001
DEFAULT_CLIENT_ID=FINATICS
STORE_FRONT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=fulfilment_dev
DB_USER=postgres
DB_PASSWORD=

# Local development may use DEV_HS256.
# Never use DEV_HS256 in TEST or PRODUCTION.
AUTH_MODE=DEV_HS256
AUTH_PROVIDER_NAME=DEV
AUTH_DEV_HS256_SECRET=
ADMIN_ROLE=admin

ORDER_ACCESS_TOKEN_SECRET=
ORDER_ACCESS_TOKEN_TTL=30d

PAYMENT_TIMEOUT_MINUTES=30

# Development must never use live Stripe credentials.
STRIPE_MODE=TEST
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

API_BASE_URL=http://localhost:3001
