# DYNETIC WMS - PRODUCTION API TEMPLATE
# Copy to: config/environments/production.api.env
# NEVER commit the populated file.
#
# This template intentionally contains no real credentials.

DYNETIC_ENVIRONMENT=PRODUCTION

PORT=3001
DEFAULT_CLIENT_ID=FINATICS
STORE_FRONT_ORIGIN=https://www.finaticsaquatics.co.uk

DB_HOST=localhost
DB_PORT=5432
DB_NAME=fulfilment_prod
DB_USER=postgres
DB_PASSWORD=

# Production authentication MUST use OIDC.
# DEV_HS256 is deliberately not acceptable for production.
AUTH_MODE=OIDC
AUTH_PROVIDER_NAME=AUTH0
AUTH_ISSUER=
AUTH_AUDIENCE=https://api.finaticsaquatics.co.uk
AUTH_JWKS_URL=
ADMIN_ROLE=admin

# Generate a long random value and keep server-side only.
ORDER_ACCESS_TOKEN_SECRET=
ORDER_ACCESS_TOKEN_TTL=30d

PAYMENT_TIMEOUT_MINUTES=30

# Safe default for the production application is Stripe TEST mode.
# Change this to LIVE only when live payments are intentionally enabled
# together with the correct live credentials.
STRIPE_MODE=TEST
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
