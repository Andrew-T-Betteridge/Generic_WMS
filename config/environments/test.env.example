# DYNETIC WMS - TEST API ENVIRONMENT
# Contains no real credentials.
# test.auth0.env.example is the canonical Auth0 TEST template.

DYNETIC_ENVIRONMENT=TEST

PORT=3101
DEFAULT_CLIENT_ID=FINATICS
STORE_FRONT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=fulfilment_test
DB_USER=postgres
DB_PASSWORD=

AUTH_MODE=OIDC
AUTH_PROVIDER_NAME=AUTH0
AUTH_ISSUER=
AUTH_AUDIENCE=https://test-api.finaticsaquatics.co.uk
AUTH_JWKS_URL=
ADMIN_ROLE=admin

ORDER_ACCESS_TOKEN_SECRET=
ORDER_ACCESS_TOKEN_TTL=30d

PAYMENT_TIMEOUT_MINUTES=30

STRIPE_MODE=TEST
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

API_BASE_URL=http://localhost:3101
