# DYNETIC WMS - AUTH0 TEST/UAT API ENVIRONMENT
# Generated values can be written by scripts/configure-auth0-test.ps1.
# Do not commit a populated file if you later add secrets.

PORT=3001
DEFAULT_CLIENT_ID=FINATICS
STORE_FRONT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=fulfilment_test
DB_USER=postgres
DB_PASSWORD=

AUTH_MODE=OIDC
AUTH_PROVIDER_NAME=AUTH0
AUTH_ISSUER=
AUTH_AUDIENCE=https://test-api.finaticsaquatics.co.uk
AUTH_JWKS_URL=
ADMIN_ROLE=admin

# Existing local guest-order token secret may be used for TEST only.
# Do not copy a TEST value into production.
ORDER_ACCESS_TOKEN_SECRET=
ORDER_ACCESS_TOKEN_TTL=30d

PAYMENT_TIMEOUT_MINUTES=30

# Keep Stripe TEST credentials in your existing TEST setup.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
