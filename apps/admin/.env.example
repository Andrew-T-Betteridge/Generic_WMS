# DYNETIC Admin
#
# Builds fail if required settings are missing or if an environment
# points at the wrong API.

VITE_DYNETIC_ENVIRONMENT=DEVELOPMENT

# DEVELOPMENT must use a local API.
VITE_API_BASE_URL=http://localhost:3001

# Supply your non-production Auth0 application settings.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://test-api.finaticsaquatics.co.uk

VITE_ADMIN_TITLE=FINatics Control
