PORT=3001
DEFAULT_CLIENT_ID=FINATICS
STORE_FRONT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=fulfilment_dev
DB_USER=postgres
DB_PASSWORD=

# Production default: OIDC / JWKS. Point these at the chosen identity provider.
AUTH_MODE=OIDC
AUTH_PROVIDER_NAME=OIDC
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
ADMIN_ROLE=admin

# DEV_HS256 is only for local automated/manual testing.
AUTH_DEV_HS256_SECRET=

# Signs guest-only order lookup tokens returned after guest checkout.
ORDER_ACCESS_TOKEN_SECRET=
ORDER_ACCESS_TOKEN_TTL=30d
PAYMENT_TIMEOUT_MINUTES=30

# Stripe test keys first. Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
